{
  "name": "art-sell-root",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace frontend run start",
    "lint": "npm --workspace frontend run lint",
    "typecheck": "npm --workspace frontend run typecheck",
    "backend:dev": "npm --workspace backend run start:dev",
    "backend:start": "npm --workspace backend run start",
    "backend:build": "npm --workspace backend run build",
    "backend:prisma:generate": "npm --workspace backend run prisma:generate",
    "install:frontend": "npm --workspace frontend install",
    "install:backend": "npm --workspace backend install"
  }
}
